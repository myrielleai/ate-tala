# Copy these into Streamlit Community Cloud: your app > Settings > Secrets.
# Never commit a real secrets.toml to GitHub.
LLM_BASE_URL = "https://api.together.xyz/v1"      # or your provider's OpenAI-compatible URL
LLM_API_KEY  = "paste-your-api-key-here"
LLM_MODEL    = "provider/model-name"              # e.g. the provider's name for Qwen2.5-7B-Instruct
